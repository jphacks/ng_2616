hackerserver.japaneast.cloudapp.azure.com {
    request_body {
        max_size 2MiB
    }
    # One handle per service on compiler-private (compose.azure.yaml); unknown paths stay 404.
    @compiler path /api/v1/reports/compile /api/v1/health
    handle @compiler {
        reverse_proxy pdf-compiler:8001 {
            transport http {
                response_header_timeout 45s
            }
        }
    }
    # lean-worker serves /health and /check; the gateway calls them as /lean/health, /lean/check.
    handle_path /lean/* {
        reverse_proxy lean-worker:8100 {
            transport http {
                # above the worker's 20 s per check
                response_header_timeout 45s
            }
        }
    }
    handle {
        respond "Not found" 404
    }
}
