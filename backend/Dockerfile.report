# Separate compiler image; the handwriting/AI backend does not depend on TeX.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_LINK_MODE=copy
RUN apt-get update && apt-get install -y --no-install-recommends texlive-luatex texlive-latex-extra texlive-lang-japanese texlive-fonts-recommended \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.13.5 /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY app ./app
RUN groupadd --gid 10001 compiler && useradd --uid 10001 --gid 10001 --no-create-home compiler \
    && mkdir -p /var/cache/luatex && chown 10001:10001 /var/cache/luatex
ENV TEXMFCACHE=/var/cache/luatex TEXMFVAR=/var/cache/luatex
USER 10001:10001
RUN luaotfload-tool --update --force
COPY --chown=10001:10001 report-warmup.tex /tmp/report-warmup.tex
RUN cd /tmp && lualatex --no-shell-escape --nosocket -interaction=nonstopmode -halt-on-error report-warmup.tex \
    && rm report-warmup.*
ENV TEXMFCACHE=/tmp/mn-texcache TEXMFVAR=/tmp/mn-texcache
EXPOSE 8001
CMD ["/app/.venv/bin/uvicorn", "app.reports_api:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "1"]
