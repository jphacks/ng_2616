{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "state": {
      "type": "string",
      "enum": [
        "GENERATED",
        "NONE"
      ]
    },
    "reason": {
      "type": "string"
    },
    "mock": {
      "type": "boolean"
    },
    "candidate": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "COMPLETE_RHS",
            "NEXT_STEP",
            "BRIDGE"
          ]
        },
        "content_hash": {
          "type": "string"
        },
        "lines": {
          "minItems": 1,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "target": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "premise",
                      "definition",
                      "step",
                      "text"
                    ]
                  },
                  "segments": {
                    "type": "array",
                    "items": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "text"
                            },
                            "text": {
                              "type": "string",
                              "maxLength": 4000
                            }
                          },
                          "required": [
                            "type",
                            "text"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "math"
                            },
                            "expr": {
                              "$ref": "#/$defs/__schema0"
                            },
                            "notation": {
                              "type": "string",
                              "enum": [
                                "plain",
                                "continuation"
                              ]
                            }
                          },
                          "required": [
                            "type",
                            "expr",
                            "notation"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "revision_of": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  "recovery_root_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  }
                },
                "required": [
                  "id",
                  "role",
                  "segments"
                ],
                "additionalProperties": false
              },
              "segments": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "text"
                        },
                        "text": {
                          "type": "string",
                          "maxLength": 4000
                        }
                      },
                      "required": [
                        "type",
                        "text"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "math"
                        },
                        "expr": {
                          "$ref": "#/$defs/__schema0"
                        },
                        "notation": {
                          "type": "string",
                          "enum": [
                            "plain",
                            "continuation"
                          ]
                        },
                        "latex": {
                          "type": "string"
                        },
                        "source_latex": {
                          "type": "string",
                          "maxLength": 4000
                        }
                      },
                      "required": [
                        "type",
                        "expr",
                        "notation",
                        "latex"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "route": {
                "type": "string",
                "enum": [
                  "cas",
                  "lean",
                  "none"
                ]
              }
            },
            "required": [
              "target",
              "segments"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "mode",
        "content_hash",
        "lines"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "state",
    "mock"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "string"
            }
          ],
          "items": {
            "$ref": "#/$defs/__schema0"
          },
          "minItems": 1
        }
      ]
    }
  }
}
