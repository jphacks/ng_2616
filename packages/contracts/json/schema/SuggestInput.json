{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "context": {
      "type": "object",
      "properties": {
        "functions": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "args": {
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "name",
              "args"
            ],
            "additionalProperties": false
          }
        },
        "lines": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "enum": [
                  "premise",
                  "definition",
                  "step",
                  "text"
                ]
              },
              "source": {
                "type": "string",
                "enum": [
                  "user",
                  "ai",
                  "pdf",
                  "resource"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "ok",
                  "wrong",
                  "unknown",
                  "none"
                ]
              },
              "segments": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "text"
                        },
                        "text": {
                          "type": "string",
                          "maxLength": 4000
                        }
                      },
                      "required": [
                        "type",
                        "text"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "math"
                        },
                        "expr": {
                          "$ref": "#/$defs/__schema0"
                        },
                        "notation": {
                          "type": "string",
                          "enum": [
                            "plain",
                            "continuation"
                          ]
                        },
                        "latex": {
                          "type": "string"
                        },
                        "source_latex": {
                          "type": "string",
                          "maxLength": 4000
                        }
                      },
                      "required": [
                        "type",
                        "expr",
                        "notation",
                        "latex"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "route": {
                "type": "string",
                "enum": [
                  "cas",
                  "lean",
                  "none"
                ]
              },
              "lean": {
                "type": "string",
                "enum": [
                  "ok",
                  "failed",
                  "unchecked",
                  "empty"
                ]
              }
            },
            "required": [
              "id",
              "role",
              "source",
              "segments"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "lines"
      ],
      "additionalProperties": false
    },
    "mode": {
      "type": "string",
      "enum": [
        "COMPLETE_RHS",
        "NEXT_STEP",
        "BRIDGE"
      ]
    },
    "based_on_line_id": {
      "type": "string"
    },
    "target_line_id": {
      "type": "string"
    },
    "lhs_expr": {
      "$ref": "#/$defs/__schema0"
    },
    "rejected_hashes": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rejected_latex": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4000
      }
    },
    "checker_feedback": {
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "latex": {
            "type": "string",
            "maxLength": 4000
          },
          "reason": {
            "type": "string",
            "maxLength": 64
          },
          "evidence": {
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500
            }
          }
        },
        "required": [
          "latex",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "reference": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "text": {
            "type": "string",
            "maxLength": 9000
          }
        },
        "required": [
          "name",
          "page",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "ui_lang": {
      "type": "string",
      "enum": [
        "en",
        "ja"
      ]
    },
    "demo": {
      "type": "object",
      "properties": {
        "script": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "script"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "context",
    "mode",
    "based_on_line_id",
    "target_line_id",
    "rejected_hashes",
    "ui_lang"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "string"
            }
          ],
          "items": {
            "$ref": "#/$defs/__schema0"
          },
          "minItems": 1
        }
      ]
    }
  }
}
