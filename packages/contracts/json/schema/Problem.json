{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "title": {
      "type": "string"
    },
    "statement": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "text"
              },
              "text": {
                "type": "string",
                "maxLength": 4000
              }
            },
            "required": [
              "type",
              "text"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "math"
              },
              "expr": {
                "$ref": "#/$defs/__schema0"
              },
              "notation": {
                "type": "string",
                "enum": [
                  "plain",
                  "continuation"
                ]
              },
              "latex": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "expr",
              "notation",
              "latex"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "definitions": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "conditions": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "assumptions": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "real",
              "positive",
              "nonnegative",
              "nonzero",
              "positive_integer",
              "interval"
            ]
          },
          "lower": {
            "$ref": "#/$defs/__schema0"
          },
          "upper": {
            "$ref": "#/$defs/__schema0"
          },
          "expr": {
            "$ref": "#/$defs/__schema0"
          },
          "source": {
            "type": "string",
            "enum": [
              "user",
              "adopted"
            ]
          }
        },
        "required": [
          "symbol",
          "kind",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "unknowns": {
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "independent_var": {
      "type": "string"
    },
    "functions": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "args": {
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "args"
        ],
        "additionalProperties": false
      }
    },
    "origin": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "preset",
            "pdf",
            "resource"
          ]
        },
        "name": {
          "type": "string"
        },
        "page": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "title",
    "statement",
    "definitions",
    "conditions",
    "assumptions",
    "unknowns"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "string"
            }
          ],
          "items": {
            "$ref": "#/$defs/__schema0"
          },
          "minItems": 1
        }
      ]
    }
  }
}
