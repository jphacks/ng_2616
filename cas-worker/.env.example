# cas-worker settings (all optional). Copy to .env.
# local: loopback development, key optional. preview/production: /verify refuses to run without a key
APP_ENV=local
# Shared secret with the gateway's CAS_WORKER_KEY (at least 32 random bytes off loopback)
CAS_WORKER_KEY=
# spec §9.3: five seconds per check
CHECK_TIMEOUT_S=5
POOL_SIZE=2
QUEUE_WAIT_S=3
