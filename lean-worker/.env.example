# lean-worker settings (all optional). Copy to .env.
# The pinned Lean project (lakefile.toml, lean-toolchain, built .lake); defaults to ./lean
LEAN_PROJECT_DIR=
# lake on PATH by default
LAKE_PATH=lake
# Shared secret with the gateway's LEAN_WORKER_KEY; required by /check whenever it is set
LEAN_WORKER_KEY=
# spec §14.4: twenty seconds per check; importing Mathlib can take minutes on a cold disk
CHECK_TIMEOUT_S=20
IMPORT_TIMEOUT_S=600
# comma list of modules checks start from; default: a school + first-year analysis part of Mathlib
LEAN_IMPORTS=
