{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare-assets": "node ../packages/cas-core/build.mjs && node scripts/copy-pdfjs.mjs && node scripts/gen-feature-registry.mjs",
    "predev": "pnpm prepare-assets",
    "dev": "next dev",
    "prebuild": "pnpm prepare-assets",
    "build": "next build",
    "start": "next start",
    "typecheck": "pnpm prepare-assets && tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/unit/history.test.ts tests/unit/autosave.test.ts tests/unit/outbox.test.ts tests/unit/scratch.test.ts tests/unit/suggest-attempts.test.ts tests/unit/presets.test.ts tests/unit/plot.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@google/genai": "2.31.0",
    "@mn/contracts": "workspace:*",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "clsx": "2.1.1",
    "dexie": "4.4.7",
    "katex": "0.19.1",
    "lucide-react": "1.61.0",
    "motion": "14.1.0",
    "next": "16.4.3",
    "pdfjs-dist": "6.4.299",
    "perfect-freehand": "1.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
