# Copy to .env.local (git-ignored) and fill in. NEXT_PUBLIC_* values are visible in the browser:
# never put secrets in them.

# ── Public ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Sign-in buttons shown next to the magic link (comma list; add "azure" later for Microsoft)
NEXT_PUBLIC_AUTH_PROVIDERS=google
# Fully pinned Pyodide distribution (must match the SymPy/mpmath pins in packages/cas-core)
NEXT_PUBLIC_PYODIDE_INDEX_URL=https://cdn.jsdelivr.net/pyodide/v314.0.7/full/
# Optional Should/Could features (comma list), empty in Stage 1
NEXT_PUBLIC_ENABLED_FEATURES=
# Local-only: skip sign-in with a fixed dev user (ignored unless APP_ENV=local and `next dev`)
NEXT_PUBLIC_AUTH_DEV_BYPASS=false

# ── Server only ────────────────────────────────────────────────────────
APP_ENV=local                        # local | preview | production
AI_EXECUTION=direct                  # direct (Stage 1: Next.js calls the LLM) | relay (FastAPI)
LLM_PROVIDER=gemini                  # gemini | mock (scripted, no network)
GEMINI_API_KEY=
LLM_MODEL_RECOGNIZE=gemini-3.8-flash
LLM_MODEL_SUGGEST=gemini-3.5-flash-lite
LLM_MODEL_OCR=gemini-3.5-flash-lite
LLM_THINKING_RECOGNIZE=medium        # minimal | low | medium | high
LLM_THINKING_SUGGEST=medium
LLM_THINKING_OCR=minimal

# relay mode only (Stage 2+)
BACKEND_URL=
BACKEND_API_KEY=
